import { VerticalBox, CheckBox } from "std-widgets.slint";
import { BrowseRow, AddressRow } from "config.slint";
import { TransferData, TransferList } from "transfers.slint";

export component AppWindow inherits Window {
    title: "bee-sync Server";
    preferred-width: 720px;
    preferred-height: 560px;

    // ── Server Config ──
    in-out property<string> bind-address: "0.0.0.0";
    in-out property<string> port: "19999";
    in-out property<string> output-dir: "./received";
    in-out property<string> temp-dir: "";
    in-out property<bool> temp-same-as-output: true;
    in-out property<string> cert-path: "";
    in-out property<string> key-path: "";

    // ── Server State ──
    in-out property<bool> server-running: false;
    in-out property<string> server-status: "Stopped";

    // ── Transfer model ──
    in-out property<[TransferData]> transfers: [];

    VerticalBox {
        spacing: 4px;
        padding: 8px;

        // ── Row 1: Bind address + Start/Stop ──
        AddressRow {
            address: root.bind-address;
            port: root.port;
            server-running: root.server-running;
            toggle => { root.start-stop-server(); }
        }

        // ── Row 2: Output dir ──
        BrowseRow {
            label: "Output:";
            value: root.output-dir;
            enabled: !root.server-running;
            browse => { root.browse-output-dir(); }
        }

        // ── Row 3: Temp dir checkbox ──
        CheckBox {
            text: "Use output as temp dir";
            checked <=> root.temp-same-as-output;
            enabled: !root.server-running;
        }

        // ── Row 4: Temp dir ──
        BrowseRow {
            label: "Temp:";
            value: root.temp-dir;
            enabled: !root.server-running && !root.temp-same-as-output;
            browse => { root.browse-temp-dir(); }
        }

        // ── Row 5: TLS cert ──
        BrowseRow {
            label: "Cert:";
            value: root.cert-path;
            enabled: !root.server-running;
            browse => { root.browse-cert(); }
        }

        // ── Row 6: TLS key ──
        BrowseRow {
            label: "Key:";
            value: root.key-path;
            enabled: !root.server-running;
            browse => { root.browse-key(); }
        }

        // ── Separator ──
        Text {
            text: "Active Transfers";
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }

        // ── Transfer list ──
        TransferList {
            transfers: root.transfers;
        }
    }

    callback start-stop-server();
    callback browse-output-dir();
    callback browse-temp-dir();
    callback browse-cert();
    callback browse-key();
}
